{
  "manifestVersion": 5,
  "id": "com.edisonengineer.gemini-writer",
  "name": "Gemini Writer",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "geminiPanel",
      "label": { "default": "Gemini Writer" },
      "minimumSize": { "width": 260, "height": 400 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 600 },
      "preferredFloatingSize": { "width": 360, "height": 640 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["https://generativelanguage.googleapis.com"]
    }
  }
}
